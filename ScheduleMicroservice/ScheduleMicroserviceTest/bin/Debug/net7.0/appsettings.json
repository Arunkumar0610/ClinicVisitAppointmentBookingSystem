{
  "Jwt": {
    "key": "Clinic Visit Appointment Booking System Secret Key"
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": ".\\Logs\\log.txt",
          "outputTemplate": "{Timestamp:G} {Message}{NewLine:1}{Exception:1}"
        }
      }
    ]
  },
  "DatabaseSettings": {
    "ClinicCollectionName1": "ClinicAndServices",
    "ClinicCollectionName2": "ScheduledAppointments",
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ClinicDB"
  },
  "AllowedHosts": "*"
}
